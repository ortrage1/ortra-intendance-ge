---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Search from '../components/Search.astro';

const reponses = (await getCollection('reponses')).sort((a, b) => a.data.ordre - b.data.ordre);
const populaires = (await getCollection('documents')).filter((d) => d.data.populaire);
const profils = [
  { q: 'AFP ou CFC', titre: 'Je découvre le métier', texte: 'Jeunes et parents : CFC ou AFP, trouver une place', icone: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM4 21c1.5-4 4.5-6 8-6s6.5 2 8 6' },
  { q: 'Diplôme adulte', titre: 'Je me reconvertis', texte: "Adultes : faire reconnaître son expérience", icone: 'M4 17 10 11l4 4 6-7M15 8h5v5' },
  { q: 'Plan de formation', titre: 'Je forme', texte: 'Entreprises et formateurs : plans, outils, obligations', icone: 'M7 4h10a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3ZM8 9h8M8 13h8M8 17h5' },
  { q: 'Examen final', titre: "J'évalue", texte: "Experts et commissaires : documents d'examen", icone: 'M5 12.5 10 17l9-10' },
];
const badge = (f: string) => (f === 'les-deux' ? 'CFC·AFP' : f.toUpperCase());
---
<Base title="Accueil">
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Gestionnaire CFC · Employé·e AFP · Genève</p>
      <h1>Toutes les réponses sur les métiers de l'hôtellerie-intendance à Genève</h1>
      <p class="lede">Rassemblées, expliquées simplement et reliées aux sources officielles.</p>
      <Search />
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2>Vous êtes…</h2>
      <div class="profiles">
        {profils.map((p) => (
          <button class="profile" type="button" data-q={p.q}>
            <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><path d={p.icone} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <strong>{p.titre}</strong><span>{p.texte}</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap split">
      <div>
        <h2>Questions les plus posées</h2>
        <ul class="list">
          {reponses.map((r) => (
            <li><a href={`/reponses/${r.id}/`}><span class="txt">{r.data.titre}</span><span class="arrow" aria-hidden="true">→</span></a></li>
          ))}
        </ul>
      </div>
      <div>
        <h2>Documents les plus consultés</h2>
        <ul class="list">
          {populaires.map((d) => (
            <li><a href={d.data.url} target="_blank" rel="noopener">
              <span class={`badge ${d.data.formation}`}>{badge(d.data.formation)}</span>
              <span class="txt">{d.data.titre}<span class="meta">{d.data.editeur} · vérifié le {d.data.verifieLe.toLocaleDateString('fr-CH')}</span></span>
              <span class="arrow" aria-hidden="true">↗</span>
            </a></li>
          ))}
        </ul>
        <p class="more"><a href="/documents/">Tous les documents</a></p>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="note">
        <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" fill="none" stroke="currentColor" stroke-width="1.8" /><circle cx="12" cy="9.5" r="2.5" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
        <h2>Bon à savoir à Genève</h2>
        <p>Les apprentis genevois suivent leurs cours hors du canton : à Marcelin (VD) pour l'orientation intendance, à Crans-Montana (VS) pour l'orientation hôtellerie. Les adultes qui passent par l'article 32 se forment à Genève. <a href="/reponses/lieux-des-cours/">En savoir plus</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(32px, 6vw, 72px) clamp(16px, 3vw, 32px) }
  .eyebrow { font-size: .8rem; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 0 0 12px }
  h1 { max-width: 22ch }
  .lede { font-size: 1.15rem; color: var(--muted); max-width: 46ch; margin: 0 0 24px }
  .block { padding-block: clamp(24px, 4vw, 44px) }
  .profiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px }
  @media (max-width: 900px) { .profiles { grid-template-columns: repeat(2, minmax(0, 1fr)) } }
  @media (max-width: 460px) { .profiles { grid-template-columns: 1fr } }
  .profile { display: flex; flex-direction: column; gap: 8px; text-align: left; font: inherit; color: inherit; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px; cursor: pointer; transition: border-color var(--dur-fast) var(--ease), transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease) }
  .profile:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: 0 10px 24px -16px rgb(0 0 0 / .35) }
  .profile:active { transform: scale(.99) }
  .profile svg { color: var(--accent) }
  .profile strong { font-size: 1.05rem }
  .profile span { font-size: .92rem; color: var(--muted) }
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 56px) }
  @media (max-width: 820px) { .split { grid-template-columns: 1fr } }
  .more { margin: 12px 0 0; font-weight: 600 }
  .note { background: var(--soft); border-radius: var(--radius); padding: 20px 22px; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 4px 16px }
  .note svg { color: var(--accent); grid-row: span 2 }
  .note h2 { font-size: 1.15rem; margin: 0 }
  .note p { margin: 0; max-width: 62ch }
</style>
