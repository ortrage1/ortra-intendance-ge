---
import Base from '../../layouts/Base.astro';
import Rubrique from '../../components/Rubrique.astro';
---
<Base title="Former" description="Entreprises formatrices en hôtellerie-intendance à Genève : autorisation de former, engagement, suivi des apprentis, contrat, difficultés.">
  <div class="wrap page">
    <nav class="crumbs" aria-label="Fil d'Ariane"><ol><li><a href="/">Accueil</a></li><li aria-current="page">Former</li></ol></nav>
    <h1>Former des apprentis</h1>
    <p class="lede">Hôtel, EMS, hôpital, foyer ou crèche : votre établissement peut former des gestionnaires et des employé·es en hôtellerie-intendance. Voici les étapes pour commencer, puis l'essentiel pour accompagner vos apprentis au quotidien.</p>
    <Rubrique rubrique="former" titre="Devenir entreprise formatrice" />
    <Rubrique rubrique="formateurs" titre="Vous formez déjà" />
    <p class="more">Plans, programmes et grilles : tout est dans la <a href="/documents/">bibliothèque de documents</a>.</p>
  </div>
</Base>

<style>
  .page { padding-block: 40px 0 }
  .lede { font-size: 1.15rem; color: var(--muted); max-width: var(--measure) }
  .more { margin-top: 24px; color: var(--muted) }
</style>
