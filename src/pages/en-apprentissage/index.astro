---
import Base from '../../layouts/Base.astro';
import Rubrique from '../../components/Rubrique.astro';
---
<Base title="En apprentissage" description="Vous êtes en apprentissage en hôtellerie-intendance à Genève : horaires, frais de trajet, aide, examen final, et après.">
  <div class="wrap page">
    <nav class="crumbs" aria-label="Fil d'Ariane"><ol><li><a href="/">Accueil</a></li><li aria-current="page">En apprentissage</li></ol></nav>
    <h1>Vous êtes en apprentissage</h1>
    <p class="lede">Vos droits, vos démarches et les personnes à qui vous adresser, de la première année jusqu'à l'examen final.</p>
    <Rubrique rubrique="apprentis" titre="Vos questions" />
  </div>
</Base>

<style>
  .page { padding-block: 40px 0 }
  .lede { font-size: 1.15rem; color: var(--muted); max-width: var(--measure) }
</style>
