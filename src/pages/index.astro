---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Search from '../components/Search.astro';
import Illustration from '../components/Illustration.astro';

const reponses = (await getCollection('reponses')).sort((a, b) => a.data.ordre - b.data.ordre);
const populaires = (await getCollection('documents')).filter((d) => d.data.populaire);
// L'encadré genevois reprend la fiche « Où ont lieu les cours ? » : une seule source à corriger.
const lieux = reponses.find((r) => r.id === 'lieux-des-cours')!;
const profils = [
  { q: 'AFP ou CFC', titre: 'Je découvre le métier', texte: 'Jeunes et parents : CFC ou AFP, trouver une place', icone: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM4 21c1.5-4 4.5-6 8-6s6.5 2 8 6' },
  { q: 'Diplôme adulte', titre: 'Je me reconvertis', texte: "Adultes : faire reconnaître son expérience", icone: 'M4 17 10 11l4 4 6-7M15 8h5v5' },
  { q: 'Plan de formation', titre: 'Je forme', texte: 'Entreprises et formateurs : plans, outils, obligations', icone: 'M7 4h10a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3ZM8 9h8M8 13h8M8 17h5' },
  { q: 'Examen final', titre: "J'évalue", texte: "Experts et commissaires : documents d'examen", icone: 'M5 12.5 10 17l9-10' },
];
const badge = (f: string) => (f === 'les-deux' ? 'CFC·AFP' : f.toUpperCase());
---
<Base title="Accueil">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
      <h1>Toutes les réponses sur les métiers de l'hôtellerie-intendance à Genève</h1>
      <p class="lede">Gestionnaire CFC et employé·e AFP : formations, examens et démarches, expliqués simplement et reliés aux sources officielles.</p>
      <Search />
      </div>
      <Illustration nom="accueil" class="hero-illu" />
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2>Vous êtes…</h2>
      <ul class="paths">
        {profils.map((p) => (
          <li>
            <button class="path" type="button" data-q={p.q}>
              <span class="ico" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24"><path d={p.icone} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
              <span class="txt"><strong>{p.titre}</strong><span>{p.texte}</span></span>
              <span class="go" aria-hidden="true">→</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="block">
    <div class="wrap split">
      <div>
        <h2>Questions les plus posées</h2>
        <ul class="list">
          {reponses.map((r) => (
            <li><a href={`/reponses/${r.id}/`}><span class="txt">{r.data.titre}</span><span class="arrow" aria-hidden="true">→</span></a></li>
          ))}
        </ul>
      </div>
      <div>
        <h2>Documents les plus consultés</h2>
        <ul class="list">
          {populaires.map((d) => (
            <li><a href={d.data.url} target="_blank" rel="noopener">
              <span class={`badge ${d.data.formation}`}>{badge(d.data.formation)}</span>
              <span class="txt">{d.data.titre}<span class="meta">{d.data.editeur} · vérifié le {d.data.verifieLe.toLocaleDateString('fr-CH')}</span></span>
              <span class="arrow" aria-hidden="true">↗</span>
            </a></li>
          ))}
        </ul>
        <p class="more"><a href="/documents/">Tous les documents</a></p>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="note">
        <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" fill="none" stroke="currentColor" stroke-width="1.8" /><circle cx="12" cy="9.5" r="2.5" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
        <h2>Bon à savoir à Genève</h2>
        <p>{lieux.data.resume} <a href="/reponses/lieux-des-cours/">En savoir plus</a>{lieux.data.statut === 'a-confirmer' && <span class="statut a-confirmer"> À confirmer avant publication</span>}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(32px, 6vw, 72px) clamp(16px, 3vw, 32px) }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 56px); align-items: center }
  .hero-text { min-width: 0 }
  .hero-illu { max-width: 440px; justify-self: end; width: 100% }
  /* Sur téléphone, la recherche reste visible sans défiler : l'illustration s'efface. */
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr } .hero-illu { display: none } }
  h1 { max-width: 22ch }
  .lede { font-size: 1.15rem; color: var(--muted); max-width: 52ch; margin: 0 0 24px }
  .block { padding-block: clamp(24px, 4vw, 44px) }
  /* « Vous êtes… » : quatre chemins sous forme de liste, pas de cartes identiques. */
  .paths { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(24px, 4vw, 56px); border-top: 1px solid var(--line) }
  @media (max-width: 720px) { .paths { grid-template-columns: 1fr } }
  .paths li { border-bottom: 1px solid var(--line) }
  .path { width: 100%; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 16px; padding: 16px 6px; text-align: left; font: inherit; color: inherit; background: transparent; border: 0; border-radius: 10px; cursor: pointer; transition: background var(--dur-fast) var(--ease) }
  .path:hover { background: var(--soft) }
  .path .ico { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: var(--soft); color: var(--accent); transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease) }
  .path:hover .ico { background: var(--accent); color: var(--accent-ink) }
  .path .txt { display: flex; flex-direction: column; gap: 2px; min-width: 0 }
  .path strong { font-family: var(--f-display); font-size: 1.12rem }
  .path .txt span { font-size: .95rem; color: var(--muted) }
  .path .go { color: var(--accent); font-size: 1.2rem; transition: transform var(--dur-fast) var(--ease) }
  .path:hover .go { transform: translateX(4px) }
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 56px) }
  @media (max-width: 820px) { .split { grid-template-columns: 1fr } }
  .more { margin: 12px 0 0; font-weight: 600 }
  .note { background: var(--soft); border-radius: var(--radius); padding: 20px 22px; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 4px 16px }
  .note svg { color: var(--accent); grid-row: span 2 }
  .note h2 { font-size: 1.15rem; margin: 0 }
  .note p { margin: 0; max-width: 62ch }
</style>
