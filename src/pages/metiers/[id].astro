---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SourceBox from '../../components/SourceBox.astro';
import Illustration from '../../components/Illustration.astro';

export async function getStaticPaths() {
  const metiers = await getCollection('metiers');
  return metiers.map((m) => ({ params: { id: m.id }, props: { metier: m } }));
}
const { metier } = Astro.props;
const { Content } = await render(metier);
const autre = metier.data.sigle === 'CFC' ? { href: '/metiers/afp/', label: 'Voir la formation AFP (2 ans)' } : { href: '/metiers/cfc/', label: 'Voir la formation CFC (3 ans)' };
---
<Base title={metier.data.titre} description={metier.data.resume}>
  <article class="wrap narrow page" data-pagefind-body data-pagefind-filter={`formation:${metier.data.formation}`}>
    <nav class="crumbs" aria-label="Fil d'Ariane"><ol><li><a href="/">Accueil</a></li><li>Les métiers</li><li aria-current="page">{metier.data.sigle}</li></ol></nav>
    <h1 data-pagefind-meta="title">{metier.data.titre}</h1>
    <dl class="facts">
      <div><dt>Diplôme</dt><dd><span class={`badge ${metier.data.formation}`}>{metier.data.sigle}</span></dd></div>
      <div><dt>Durée</dt><dd>{metier.data.duree}</dd></div>
    </dl>
    <p class="lede">{metier.data.resume}</p>
    {metier.data.anciensNoms.length > 0 && (
      <p class="aka"><strong>Vous connaissez peut-être ce métier sous un autre nom :</strong> {metier.data.anciensNoms.join(' · ')}</p>
    )}
    <Illustration nom={metier.data.formation === 'afp' ? 'afp' : 'cfc'} class="fiche-illu" />
    <div class="prose"><Content /></div>
    <p class="next"><a href="/reponses/cfc-ou-afp/">Comparer le CFC et l'AFP</a> · <a href={autre.href}>{autre.label}</a></p>
    <SourceBox libelle={metier.data.source.libelle} url={metier.data.source.url} verifieLe={metier.data.verifieLe} />
  </article>
</Base>

<style>
  .page { padding-block: 40px 0 }
  .facts { display: flex; flex-wrap: wrap; gap: 0; margin: 8px 0 20px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); width: fit-content; max-width: 100% }
  .facts div { padding: 10px 18px; display: flex; flex-direction: column; gap: 2px }
  .facts div + div { border-left: 1px solid var(--line) }
  .facts dt { font-size: .78rem; color: var(--muted) }
  .facts dd { margin: 0; font-weight: 700 }
  .lede { font-size: 1.15rem; color: var(--muted); max-width: var(--measure) }
  .page :global(.fiche-illu) { max-width: 420px; margin: 8px 0 12px }
  .aka { font-size: .95rem; background: var(--soft); border-radius: 12px; padding: 12px 16px; max-width: var(--measure) }
  .next { margin-top: 28px; font-weight: 600 }
</style>
